{
  // Cloudflare serves web/ as static assets; there is no Worker code, because
  // the editor runs entirely in the visitor's browser and has no backend.
  "name": "stalker2-save-editor",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "web"
  },
  "observability": {
    "enabled": true
  }
}
